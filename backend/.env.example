# Copy this file to backend/.env for local development if your runner loads env files,
# or set the same variables in your shell before starting FastAPI.

WASTEWISE_MODEL_PATH=app/models/mobilenetv3_trashbox.torchscript.pt
WASTEWISE_INFERENCE_BUNDLE_PATH=app/models/inference_bundle.json
WASTEWISE_CONFIDENCE_THRESHOLD=0.6

# Keep this backend-only. Never expose it through EXPO_PUBLIC_* variables.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
